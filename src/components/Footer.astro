---
import site from '../data/site.json';
import legal from '../data/legal.json';

const mapsUrl = (address: string, city: string) =>
  `https://yandex.ru/maps/?text=${encodeURIComponent(`${city}, ${address}`)}`;
---

<div class="footer" data-footer>
  <div class="footer__card">
    <div class="footer__left">
      <h2 class="t-heading-2">до встречи в саду</h2>
      <p class="t-body">
        Бьюти-услуги с любовью и заботой.<br />
        Пушкин и Санкт-Петербург, {site.hours.toLowerCase()}.
      </p>
    </div>
    <ul class="footer__links t-body">
      {site.studios.map((s) => (
        <li>
          <a href={mapsUrl(s.address, s.city)} target="_blank" rel="noopener">{s.city}, {s.address}</a>
        </li>
      ))}
      <li><a href={site.phoneHref}>{site.phone}</a></li>
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      <li><a href={site.channel.vk} target="_blank" rel="noopener">ВКонтакте</a></li>
      <li><a href={site.channel.telegram} target="_blank" rel="noopener">Telegram-канал</a></li>
    </ul>
  </div>

  <div class="footer__word" data-footer-word aria-hidden="true">the garden</div>

  <div class="footer__legal t-small">
    <details>
      <summary>{legal.title}</summary>
      <div class="footer__legal-body">
        <p>{legal.offer}</p>
        {legal.orgs.map((org) => (
          <section>
            <h3 class="t-small">{org.name}</h3>
            <ul>
              {org.lines.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </section>
        ))}
        <p>
          <a href={site.privacy} target="_blank" rel="noopener">Политика конфиденциальности</a>
        </p>
      </div>
    </details>
    <p class="footer__copy">© 2026 The Garden</p>
  </div>
</div>

<style>
  .footer {
    background: var(--color-peony);
    padding: var(--space-section) 10px 0;
    overflow: hidden;
  }
  .footer__card {
    background: var(--color-pearl);
    border-radius: 32px;
    padding: var(--space-7) var(--space-5);
    display: grid;
    gap: var(--space-6);
    color: var(--color-plum);
  }
  .footer__left p {
    margin-top: var(--space-3);
    max-width: 24em;
    color: var(--color-plum-2);
  }
  .footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .footer__links a,
  .footer__legal a {
    color: var(--color-plum);
    text-underline-offset: 0.2em;
  }

  .footer__word {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 22vw;
    line-height: 0.82;
    letter-spacing: -0.05em;
    text-align: center;
    white-space: nowrap;
    color: var(--color-plum);
    margin-top: var(--space-8);
    /* нижняя треть обрезана краем экрана */
    margin-bottom: -4vw;
    padding-bottom: 0.1em;
    will-change: transform;
  }

  .footer__legal {
    position: relative;
    z-index: 1;
    background: var(--color-peony);
    padding: var(--space-5) var(--space-2) var(--space-5);
    color: var(--color-plum-2);
  }
  .footer__legal summary {
    cursor: pointer;
    color: var(--color-plum);
    width: max-content;
  }
  .footer__legal-body {
    margin-top: var(--space-4);
    display: grid;
    gap: var(--space-4);
    max-width: 60em;
    font-size: 14px;
    line-height: 1.5;
  }
  .footer__legal-body ul {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
  }
  .footer__legal-body h3 {
    margin: 0;
    color: var(--color-plum);
    font-weight: 500;
  }
  .footer__copy {
    margin-top: var(--space-4);
  }

  @media (min-width: 1024px) {
    .footer {
      padding-inline: 20px;
    }
    .footer__card {
      grid-template-columns: 4fr 6fr;
      margin-inline: calc(100% / 12);
      padding: 64px;
      gap: var(--space-8);
    }
    .footer__legal {
      padding-inline: calc(100% / 12);
    }
  }
</style>

<script>
  import { initFooter } from '../scripts/footer';
  initFooter();
</script>
