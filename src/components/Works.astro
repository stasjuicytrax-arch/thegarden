---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/old-site/{06-works,04-studio-pushkin,05-studio-frunzenskaya}/*',
  { eager: true }
);
const fileFor = (rel: string): ImageMetadata => {
  const hit = Object.entries(files).find(([k]) => k.endsWith('/' + rel));
  if (!hit) throw new Error('нет файла: ' + rel);
  return hit[1].default;
};

// Шторка: три полноэкранных кадра (TZ.md §5.6)
const curtain = [
  { file: '04-studio-pushkin/04__DSF7449.jpeg', caption: 'Пушкин, зал маникюра', position: '50% 50%' },
  { file: '05-studio-frunzenskaya/06__DSF8355.jpeg', caption: 'Фрунзенская, зона отдыха', position: '50% 55%' },
  { file: '04-studio-pushkin/07__DSF7240.jpeg', caption: 'Пушкин, парикмахерский зал', position: '50% 40%' },
];

// Мозаика: 9 фото из 06-works, «как отпечатки на стене» (12 колонок, смещение по вертикали, параллакс)
const mosaic = [
  { file: '06-works/01_IMG_8091.jpg', col: '1 / 6', shape: 'rect', shift: '0', depth: 6, pos: '50% 30%' },
  { file: '06-works/02__DSF0875.jpg', col: '8 / 12', shape: 'circle', shift: '10vw', depth: 10, pos: '50% 40%' },
  { file: '06-works/03_IMG_8084.jpg', col: '3 / 8', shape: 'circle', shift: '-2vw', depth: 8, pos: '50% 30%' },
  { file: '06-works/04_IMG_1925.jpeg', col: '9 / 13', shape: 'rect', shift: '6vw', depth: 12, pos: '50% 35%' },
  { file: '06-works/05_IMG_8090.JPG', col: '1 / 5', shape: 'rect', shift: '4vw', depth: 5, pos: '60% 60%' },
  { file: '06-works/06_IMG_8093.jpg', col: '6 / 10', shape: 'circle', shift: '-4vw', depth: 9, pos: '55% 65%' },
  { file: '06-works/07_IMG_8099.jpg', col: '10 / 13', shape: 'rect', shift: '8vw', depth: 7, pos: '40% 25%' },
  { file: '06-works/08_IMG_7981.PNG', col: '2 / 7', shape: 'rect', shift: '0', depth: 11, pos: '50% 40%' },
  { file: '06-works/09_IMG_7984.PNG', col: '8 / 12', shape: 'circle', shift: '5vw', depth: 6, pos: '50% 40%' },
];
---

<div class="works" data-works>
  <header class="works__head grid">
    <h2 class="t-heading-1">наши работы</h2>
    <p class="t-body works__sub">Мы гордимся качеством своей работы и командой мастеров</p>
  </header>

  <div class="curtain" data-curtain>
    {curtain.map((c, i) => (
      <figure class="curtain__frame" style={`z-index:${i + 1}`}>
        <Image
          src={fileFor(c.file)}
          alt={c.caption}
          width={1920}
          widths={[768, 1280, 1920]}
          sizes="100vw"
          loading="lazy"
          style={`object-position:${c.position}`}
        />
        <figcaption class="curtain__caption t-small">{c.caption}</figcaption>
      </figure>
    ))}
  </div>

  <div class="mosaic grid" data-mosaic>
    {mosaic.map((m, i) => (
      <figure
        class={`mosaic__item mosaic__item--${m.shape}`}
        style={`grid-column:${m.col};margin-top:${m.shift}`}
        data-depth={m.depth}
        data-mosaic-item
      >
        <div class="mosaic__photo" data-mosaic-photo>
          <Image
            src={fileFor(m.file)}
            alt={`Работа мастеров студии The Garden, ${i + 1}`}
            width={900}
            widths={[400, 700, 900]}
            sizes="(min-width: 1024px) 33vw, 90vw"
            loading="lazy"
            style={`object-position:${m.pos}`}
          />
        </div>
      </figure>
    ))}
  </div>
</div>

<style>
  .works {
    padding-top: var(--space-section);
  }
  .works__head {
    margin-bottom: var(--space-8);
  }
  .works__head > * {
    grid-column: 1 / -1;
  }
  .works__sub {
    margin-top: var(--space-3);
    color: var(--color-plum-2);
  }

  .curtain {
    position: relative;
  }
  .curtain__frame {
    position: sticky;
    top: 0;
    height: 100svh;
    margin: 0;
    overflow: hidden;
    background: var(--color-pearl-2);
  }
  .curtain__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .curtain__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 80px var(--grid-margin) 20px;
    color: var(--color-pearl);
    font-size: 15px;
    /* единственный разрешённый градиент: скрим под подписью, нижние 120px */
    background: linear-gradient(to top, rgba(36, 18, 40, 0.55), rgba(36, 18, 40, 0));
  }

  .mosaic {
    padding-block: var(--space-9) var(--space-section);
    row-gap: var(--space-6);
    align-items: start;
  }
  .mosaic__item {
    grid-column: 1 / -1;
    margin: 0;
  }
  .mosaic__photo {
    overflow: hidden;
  }
  .mosaic__item--circle .mosaic__photo {
    aspect-ratio: 1;
    border-radius: 50%;
  }
  .mosaic__item--rect .mosaic__photo {
    aspect-ratio: 4 / 5;
    border-radius: 24px;
  }
  .mosaic__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 1023px) {
    .mosaic__item {
      grid-column: 1 / -1 !important;
      margin-top: 0 !important;
    }
    .mosaic__item:nth-child(even) {
      width: 78%;
      justify-self: end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .curtain__frame {
      position: relative;
    }
  }
</style>

<script>
  import { initWorks } from '../scripts/works';
  initWorks();
</script>
