---
import { Picture } from 'astro:assets';
import StudioSwitch from './StudioSwitch.astro';
import ButtonPrimary from './ButtonPrimary.astro';
import pushkinPhoto from '../../assets/old-site/04-studio-pushkin/02__DSF6680.jpeg';
import frunzenskayaPhoto from '../../assets/old-site/05-studio-frunzenskaya/03__DSF3816.jpeg';

// «Зеркало-диафрагма» (TZ.md §5.1): в круге peony — фото интерьера выбранной студии;
// на скролле круг раскрывается до полного экрана.
const photos = [
  { id: 'pushkin', src: pushkinPhoto },
  { id: 'frunzenskaya', src: frunzenskayaPhoto },
];
---

<div class="hero" data-hero>
  <div class="hero__field" aria-hidden="true"></div>

  <div class="hero__disc" data-hero-disc aria-hidden="true">
    <div class="hero__frame" data-hero-frame>
      {photos.map((photo, i) => (
        <div class="hero__photo" data-hero-photo={photo.id} data-active={i === 0 ? '' : undefined}>
          <Picture
            src={photo.src}
            alt=""
            formats={['avif', 'webp']}
            widths={[768, 1280, 1920]}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'low'}
            decoding="async"
          />
        </div>
      ))}
    </div>
  </div>

  <h1 class="hero__title t-display" data-hero-title>
    <span class="hero__line-mask"><span class="line" data-hero-line>студия красоты</span></span>
    <span class="hero__line-mask"><span class="line" data-hero-line>the garden</span></span>
  </h1>

  <p class="hero__lead t-body" data-hero-fade data-hero-lead>
    Бьюти-услуги с любовью и заботой.<br />
    Пушкин и Санкт-Петербург, ежедневно 10:00–21:00.
  </p>

  <div class="hero__actions" data-hero-fade>
    <StudioSwitch />
    <ButtonPrimary class="hero__cta" data-open-booking>Записаться</ButtonPrimary>
  </div>
</div>

<style>
  .hero {
    --cx: 50%;
    --cy: 58%;
    position: relative;
    min-height: calc(100svh - var(--nav-height));
    overflow: hidden;
    display: grid;
    background: var(--color-pearl);
  }

  /* плоский круг peony ~60vw; фото в нём чуть меньше, чтобы по краю оставалось кольцо поля */
  .hero__field {
    position: absolute;
    top: var(--cy);
    left: var(--cx);
    width: 60vw;
    height: 60vw;
    max-width: 900px;
    max-height: 900px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--color-peony);
  }

  /* диафрагма: радиус --r задаёт hero.ts (px); до JS — CSS-значение */
  .hero__disc {
    --r: min(25.8vw, 387px);
    position: absolute;
    inset: 0;
    z-index: 1;
    clip-path: circle(var(--r) at var(--cx) var(--cy));
  }
  .hero__frame {
    position: absolute;
    inset: 0;
  }
  .hero__photo {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 600ms var(--ease-in-out);
    transform: scale(var(--photo-scale, 1));
    transform-origin: var(--cx) var(--cy);
  }
  .hero__photo[data-active] {
    opacity: 1;
  }
  .hero__photo :global(picture),
  .hero__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__photo :global(img) {
    object-fit: cover;
    object-position: 50% 50%;
  }

  .hero__title {
    position: relative;
    z-index: 2;
    margin: 0;
    padding-top: var(--space-9);
    text-align: center;
  }
  @media (min-width: 768px) {
    /* две строки целиком: «студия красоты» не должна переноситься */
    .hero__title {
      font-size: min(9.6vw, 176px);
      white-space: nowrap;
    }
  }

  /* маска режет по line-height 0.9 — запас снизу, чтобы не срезать выносные («у», «д», «g») */
  .hero__line-mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.15em;
    margin-bottom: -0.15em;
  }
  .hero__line-mask .line {
    display: block;
    transform: translateY(0);
  }

  .hero__lead {
    position: absolute;
    z-index: 2;
    left: var(--grid-margin);
    bottom: 32px;
    max-width: 280px;
    color: var(--color-plum);
  }

  .hero__actions {
    position: absolute;
    z-index: 2;
    right: var(--grid-margin);
    bottom: 32px;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  @media (max-width: 767px) {
    .hero {
      --cy: 52%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding-bottom: var(--space-9);
    }
    .hero__field {
      width: 110vw;
      height: 110vw;
    }
    .hero__disc {
      --r: 47vw;
    }
    .hero__title {
      padding-top: var(--space-7);
    }
    .hero__lead,
    .hero__actions {
      position: relative;
      inset: auto;
      max-width: none;
      padding-inline: var(--grid-margin);
    }
    .hero__lead {
      margin-top: var(--space-6);
    }
    .hero__actions {
      margin-top: var(--space-5);
      justify-content: space-between;
    }
    /* Кнопка «Записаться» дублируется глобальной sticky-CTA (StickyBookCta) на мобильном. */
    .hero__actions .hero__cta {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__photo {
      transition: none;
    }
  }
</style>

<script>
  import { initHero } from '../scripts/hero';
  initHero();
</script>
