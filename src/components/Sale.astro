---
import type { ImageMetadata } from 'astro';
import promosData from '../data/promos.json';
import StudioSwitch from './StudioSwitch.astro';
import PromoCard from './PromoCard.astro';
import { WEEKDAY_LABELS } from '../scripts/calendar';

const [year, month] = promosData.month.split('-').map(Number);
const daysInMonth = new Date(year, month, 0).getDate();
const firstWeekday = (new Date(year, month - 1, 1).getDay() + 6) % 7;
const days = Array.from({ length: daysInMonth }, (_, i) => ({
  day: i + 1,
  weekday: WEEKDAY_LABELS[(firstWeekday + i) % 7],
}));

const monthName = promosData.monthLabel.split(' ')[0];
const monthGenitive = monthName.replace(/ь$/, 'я').replace(/т$/, 'та').replace(/й$/, 'я');

const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/old-site/02-promo/*', {
  eager: true,
});
const photoFor = (path: string): ImageMetadata => {
  const file = path.split('/').pop()!;
  const hit = Object.entries(photos).find(([k]) => k.endsWith('/' + file));
  return hit![1].default;
};
---

<div class="sale" data-sale data-month={promosData.month}>
  <div class="grid">
    <header class="sale__head">
      <h2 class="t-heading-1">акции {monthGenitive}</h2>
      <p class="t-body sale__sub">Чем побаловать себя в этом месяце</p>
    </header>

    <aside class="sale__calendar" aria-label="Календарь акций">
      <StudioSwitch class="sale__switch" />
      <div class="calendar" data-calendar>
        <p class="calendar__title t-small">{promosData.monthLabel}</p>
        <ul class="calendar__days">
          {days.map((d, i) => (
            <li style={i === 0 ? `--first:${firstWeekday + 1}` : undefined} data-first={i === 0 ? '' : undefined}>
              <button type="button" class="calendar__day" data-day={d.day} aria-pressed="false">
                <span class="calendar__wd t-small" aria-hidden="true">{d.weekday}</span>
                <span class="calendar__num">{d.day}</span>
              </button>
            </li>
          ))}
        </ul>
        <p class="calendar__hint t-small">Дни с акциями отмечены точкой. Нажмите на день, чтобы отфильтровать.</p>
      </div>
    </aside>

    <div class="sale__list" data-sale-list>
      {promosData.promos.map((promo, i) => (
        <PromoCard
          promo={promo as any}
          index={i}
          image={{ src: photoFor(promo.image), alt: `Акция: ${promo.title}`, position: '50% 30%' }}
        />
      ))}
      <p class="sale__empty t-body" data-sale-empty hidden>
        На этот день акций по датам нет — акции «весь месяц» действуют всегда.
      </p>
    </div>

    <div class="sale__seasonal">
      <h3 class="t-heading-2">Сезонные акции</h3>
      <ul class="sale__seasonal-list t-body">
        {promosData.seasonal.map((s) => (
          <li><strong>{s.title}</strong> {s.discount}</li>
        ))}
      </ul>
    </div>
  </div>
</div>

<style>
  .sale {
    padding-block: var(--space-section);
  }
  .sale__head {
    grid-column: 1 / -1;
    margin-bottom: var(--space-7);
  }
  .sale__sub {
    margin-top: var(--space-3);
    color: var(--color-plum-2);
  }
  .sale__calendar,
  .sale__list,
  .sale__seasonal {
    grid-column: 1 / -1;
  }
  .sale__seasonal {
    margin-top: var(--space-8);
  }
  .sale__seasonal-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: var(--space-4) 0 0;
    list-style: none;
    padding: 0;
    color: var(--color-plum);
  }
  .sale__empty {
    padding-block: var(--space-6);
    color: var(--color-plum-2);
  }

  .calendar {
    margin-top: var(--space-4);
  }
  .calendar__title {
    color: var(--color-plum-2);
    margin-bottom: var(--space-2);
  }
  .calendar__days {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0 0 var(--space-2);
    overflow-x: auto;
    scroll-snap-type: x proximity;
  }
  .calendar__day {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 48px;
    height: 56px;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-plum);
    font-family: var(--font-text);
    font-weight: 500;
    cursor: pointer;
    scroll-snap-align: start;
    transition: background-color 160ms var(--ease-out);
  }
  .calendar__wd {
    color: var(--color-plum-2);
    line-height: 1;
  }
  .calendar__day[data-has='true']::after {
    content: '';
    position: absolute;
    bottom: 5px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-leaf);
  }
  .calendar__day[data-today='true'] {
    box-shadow: inset 0 0 0 2px var(--color-plum);
  }
  .calendar__day[aria-pressed='true'] {
    background: var(--color-peony);
  }
  .calendar__hint {
    margin-top: var(--space-3);
    color: var(--color-plum-2);
  }

  @media (max-width: 1023px) {
    .sale__calendar {
      position: sticky;
      top: var(--nav-height);
      z-index: 5;
      background: var(--color-pearl);
      padding-block: var(--space-3);
    }
  }

  @media (min-width: 1024px) {
    .sale__calendar {
      grid-column: 1 / 5;
      position: sticky;
      top: calc(var(--nav-height) + var(--space-4));
      align-self: start;
    }
    .sale__list {
      grid-column: 6 / 13;
    }
    .calendar__days {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      overflow: visible;
    }
    .calendar__days li[data-first] {
      grid-column-start: var(--first);
    }
    .calendar__day {
      min-width: 0;
      width: 100%;
      height: 44px;
    }
    .calendar__wd {
      display: none;
    }
  }
</style>

<script>
  import { initSale } from '../scripts/sale';
  initSale();
</script>
