---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import site from '../data/site.json';
import ButtonPrimary from './ButtonPrimary.astro';
import Icon from './Icon.astro';

// Все 17 фото студий (TZ.md §5.5): карусель в круге-зеркале, смена каждые 4 с диафрагмой или по свайпу.
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/old-site/{04-studio-pushkin,05-studio-frunzenskaya}/*',
  { eager: true }
);
const fileFor = (path: string): ImageMetadata => {
  const name = path.split('/').slice(-2).join('/');
  const hit = Object.entries(files).find(([k]) => k.endsWith('/' + name));
  return hit![1].default;
};

const mapsUrl = (address: string, city: string) =>
  `https://yandex.ru/maps/?text=${encodeURIComponent(`${city}, ${address}`)}`;

const headings: Record<string, string[]> = {
  pushkin: ['пушкин'],
  frunzenskaya: ['фрунзенская'],
};
const bookLabel: Record<string, string> = {
  pushkin: 'Записаться в Пушкине',
  frunzenskaya: 'Записаться на Фрунзенской',
};
// первым в карусели — лучший кадр интерьера (тот же, что в hero), остальные по порядку
const studios = site.studios.map((st) => {
  const first = st.photos.indexOf(st.envMap);
  if (first <= 0) return st;
  return { ...st, photos: [st.photos[first], ...st.photos.filter((_, i) => i !== first)] };
});
---

<div class="studios" data-studios>
  {studios.map((studio, si) => (
    <article class="studio" data-studio-panel={studio.id} style={`order:${si}`} aria-labelledby={`studio-${studio.id}`}>
      <div class="studio__head">
        <h2 class="t-heading-1" id={`studio-${studio.id}`}>{headings[studio.id]}</h2>
        <p class="t-lead studio__tagline">{studio.tagline}</p>
      </div>

      <div class="studio__mirror" data-carousel role="group" aria-roledescription="карусель" aria-label={`Фото студии: ${studio.short}`}>
        <div class="studio__slides">
          {studio.photos.map((p, i) => (
            <div class="studio__slide" data-slide data-active={i === 0 ? '' : undefined}>
              <Image
                src={fileFor(p)}
                alt={`${studio.name}, фото ${i + 1} из ${studio.photos.length}`}
                width={1100}
                widths={[600, 900, 1100]}
                sizes="(min-width: 1024px) 38vw, 86vw"
                loading={i === 0 ? 'lazy' : 'lazy'}
              />
            </div>
          ))}
        </div>
        <div class="studio__dots">
          {studio.photos.map((_, i) => (
            <button
              type="button"
              class="studio__dot"
              data-dot={i}
              aria-label={`Фото ${i + 1} из ${studio.photos.length}`}
              aria-current={i === 0 ? 'true' : undefined}
            />
          ))}
        </div>
      </div>

      <div class="studio__body">
        <p class="t-body studio__text">{studio.text}</p>
        <p class="t-heading-2 studio__address">
          <a href={mapsUrl(studio.address, studio.city)} target="_blank" rel="noopener">
            {studio.address}
          </a>
        </p>
        <p class="t-small studio__hours">{site.hours}</p>
        <div class="studio__actions">
          <ButtonPrimary data-open-booking data-studio-book={studio.id}>
            {bookLabel[studio.id]}
          </ButtonPrimary>
          <ul class="studio__social" aria-label={`Мессенджеры: ${studio.short}`}>
            <li>
              <a href={studio.telegram} target="_blank" rel="noopener" aria-label={`Telegram — ${studio.short}`}>
                <Icon name="telegram" size={22} />
              </a>
            </li>
            <li>
              <a href={studio.whatsapp} target="_blank" rel="noopener" aria-label={`WhatsApp — ${studio.short}`}>
                <Icon name="whatsapp" size={22} />
              </a>
            </li>
            <li>
              <a href={studio.max} target="_blank" rel="noopener" aria-label={`MAX — ${studio.short}`}>
                <Icon name="max" size={22} />
              </a>
            </li>
          </ul>
        </div>
      </div>
    </article>
  ))}
</div>

<style>
  .studios {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 20px 10px;
  }
  .studio {
    background: var(--color-pearl-2);
    border-radius: 32px;
    padding: var(--space-7) var(--space-5);
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }
  .studio__tagline {
    margin-top: var(--space-3);
    color: var(--color-plum-2);
  }
  .studio__mirror {
    width: min(86vw, 520px);
    justify-self: center;
  }
  .studio__slides {
    position: relative;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-peony);
  }
  .studio__slide {
    position: absolute;
    inset: 0;
    visibility: hidden;
  }
  .studio__slide[data-active] {
    visibility: visible;
  }
  .studio__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .studio__dots {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: var(--space-4);
  }
  .studio__dot {
    width: 10px;
    height: 10px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-plum-2);
    opacity: 0.35;
    cursor: pointer;
    position: relative;
  }
  /* увеличенная зона нажатия */
  .studio__dot::after {
    content: '';
    position: absolute;
    inset: -12px;
  }
  .studio__dot[aria-current='true'] {
    opacity: 1;
    background: var(--color-plum);
  }

  .studio__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .studio__text {
    max-width: 300px;
    color: var(--color-plum);
  }
  .studio__address {
    margin: var(--space-3) 0 0;
  }
  .studio__address a {
    color: var(--color-plum);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .studio__hours {
    color: var(--color-plum-2);
  }
  .studio__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .studio__social {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .studio__social a {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-pearl);
    color: var(--color-plum);
  }

  @media (min-width: 1024px) {
    .studios {
      padding: 20px;
    }
    .studio {
      min-height: 100svh;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto 1fr;
      column-gap: var(--grid-gutter);
      padding: var(--space-8) var(--grid-margin) 0;
      align-items: start;
    }
    .studio__head {
      grid-column: 1 / 7;
      grid-row: 1;
    }
    .studio__mirror {
      grid-column: 1 / 6;
      grid-row: 2;
      width: 38vw;
      max-width: none;
      justify-self: start;
      align-self: end;
      /* круг обрезан низом панели */
      margin-bottom: -8vw;
    }
    .studio__body {
      grid-column: 8 / 13;
      grid-row: 1 / 3;
      padding-top: var(--space-6);
    }
  }
</style>

<script>
  import { initStudios } from '../scripts/studios';
  initStudios();
</script>
