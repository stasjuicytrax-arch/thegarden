---
// Временная 2D-заглушка хромового пиона (TZ.md §11 шаг 3: "без WebGL").
// Заменяется процедурной WebGL-сценой на Шаге 4 (§6.1) — геометрия здесь
// не претендует на точность 38 лепестков из спеки, только силуэт и ярусность.
// Цвет — только токены chrome-* (DESIGN-SYSTEM.md §2: "хром — материал
// только 3D-объекта и fallback-картинок"), без градиентов.

interface Tier {
  count: number;
  radius: number;
  length: number;
  width: number;
  fill: string;
  rotationOffset: number;
}

const TIERS: Tier[] = [
  { count: 6, radius: 34, length: 58, width: 22, fill: 'var(--color-chrome-light)', rotationOffset: 0 },
  { count: 8, radius: 22, length: 42, width: 17, fill: 'var(--color-chrome-mid)', rotationOffset: 18 },
  { count: 10, radius: 12, length: 26, width: 11, fill: 'var(--color-chrome-dark)', rotationOffset: 9 },
];

function petalPath(length: number, width: number): string {
  const hw = width / 2;
  return `M0,-4 C-${hw},-${length * 0.4} -${hw * 0.8},-${length * 0.85} 0,-${length} C${hw * 0.8},-${length * 0.85} ${hw},-${length * 0.4} 0,-4 Z`;
}

const petals = TIERS.flatMap((tier) =>
  Array.from({ length: tier.count }, (_, i) => {
    const angle = (360 / tier.count) * i + tier.rotationOffset;
    return {
      angle,
      radius: tier.radius,
      d: petalPath(tier.length, tier.width),
      fill: tier.fill,
    };
  })
);

const budPetals = Array.from({ length: 5 }, (_, i) => ({
  angle: (360 / 5) * i,
  d: petalPath(16, 8),
}));
---

<svg viewBox="0 0 200 200" class="flower-fallback" role="img" aria-label="">
  {petals.map((p) => (
    <path
      d={p.d}
      fill={p.fill}
      transform={`rotate(${p.angle} 100 100) translate(100 ${100 - p.radius})`}
    />
  ))}
  {budPetals.map((p) => (
    <path
      d={p.d}
      fill="var(--color-chrome-dark)"
      transform={`rotate(${p.angle} 100 100) translate(100 94)`}
    />
  ))}
  <circle cx="100" cy="100" r="6" fill="var(--color-chrome-mid)" />
</svg>

<style>
  .flower-fallback {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }
</style>
