---
// Инъекция @font-face с учётом BASE_URL (сайт может быть развёрнут в подпути,
// например на GitHub Pages: /thegarden/). Файлы остаются в public/fonts —
// только пути для url() собираются на лету, иначе абсолютные "/fonts/..."
// в обычном .css сломаются под base-путём.
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const LATIN_RANGE =
  'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD';
const CYRILLIC_RANGE = 'U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116';

type FontSpec = { family: string; weight: number; file: string; range: string };

const FONTS: FontSpec[] = [
  { family: 'Unbounded', weight: 200, file: 'unbounded-latin-200-normal', range: LATIN_RANGE },
  { family: 'Unbounded', weight: 200, file: 'unbounded-cyrillic-200-normal', range: CYRILLIC_RANGE },
  { family: 'Unbounded', weight: 300, file: 'unbounded-latin-300-normal', range: LATIN_RANGE },
  { family: 'Unbounded', weight: 300, file: 'unbounded-cyrillic-300-normal', range: CYRILLIC_RANGE },
  { family: 'Unbounded', weight: 400, file: 'unbounded-latin-400-normal', range: LATIN_RANGE },
  { family: 'Unbounded', weight: 400, file: 'unbounded-cyrillic-400-normal', range: CYRILLIC_RANGE },
  { family: 'Jost', weight: 400, file: 'jost-latin-400-normal', range: LATIN_RANGE },
  { family: 'Jost', weight: 400, file: 'jost-cyrillic-400-normal', range: CYRILLIC_RANGE },
  { family: 'Jost', weight: 500, file: 'jost-latin-500-normal', range: LATIN_RANGE },
  { family: 'Jost', weight: 500, file: 'jost-cyrillic-500-normal', range: CYRILLIC_RANGE },
];

const PRELOAD_FILES = [
  'unbounded-latin-300-normal',
  'unbounded-cyrillic-300-normal',
  'jost-latin-400-normal',
  'jost-cyrillic-400-normal',
];

const fontFaceCss = FONTS.map(
  (f) => `@font-face{font-family:'${f.family}';font-style:normal;font-weight:${f.weight};font-display:swap;src:url('${base}fonts/${f.file}.woff2') format('woff2');unicode-range:${f.range};}`
).join('\n');
---

{PRELOAD_FILES.map((file) => (
  <link rel="preload" as="font" type="font/woff2" href={`${base}fonts/${file}.woff2`} crossorigin />
))}
<style set:html={fontFaceCss} />
