---
import FontFaces from '../components/FontFaces.astro';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import BookingSheet from '../components/BookingSheet.astro';
import Hero from '../components/Hero.astro';
import StickyBookCta from '../components/StickyBookCta.astro';
import Intro from '../components/Intro.astro';
import Sale from '../components/Sale.astro';
import Price from '../components/Price.astro';
import Studios from '../components/Studios.astro';
import Works from '../components/Works.astro';
import Loyalty from '../components/Loyalty.astro';
import Social from '../components/Social.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import '../styles/tokens.css';
import '../styles/typography.css';
import '../styles/base.css';

const title = 'The Garden — студия красоты в Пушкине и на Фрунзенской';
const description =
  'Студия красоты The Garden: ногтевой сервис, имидж-студия, косметология, лазерная эпиляция, Brow Bar, массаж. Две студии — Пушкин и Фрунзенская. Запись онлайн.';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const origin = Astro.site ? Astro.site.origin : '';
const pageUrl = `${origin}${base}/`;
const ogImage = `${origin}${base}/og.jpg`;
const ymId = import.meta.env.PUBLIC_YM_ID;

// Структурированные данные: две студии как BeautySalon (адреса и часы — из site.json)
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': site.studios.map((s) => ({
    '@type': 'BeautySalon',
    name: `The Garden — ${s.short}`,
    url: pageUrl,
    telephone: site.phone,
    email: site.email,
    image: ogImage,
    openingHours: 'Mo-Su 10:00-21:00',
    address: {
      '@type': 'PostalAddress',
      addressLocality: s.city,
      streetAddress: s.address,
      addressCountry: 'RU',
    },
    sameAs: [site.channel.telegram, site.channel.vk],
  })),
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="theme-color" content="#F5F2F7" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="The Garden" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {ymId && (
      <script is:inline define:vars={{ ymId }}>
        (function (m, e, t, r, i, k, a) {
          m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
          m[i].l = 1 * new Date();
          k = e.createElement(t); a = e.getElementsByTagName(t)[0]; k.async = 1; k.src = r; a.parentNode.insertBefore(k, a);
        })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
        ym(ymId, 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true });
      </script>
    )}
    <FontFaces />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <Header />
    <MobileMenu />
    <BookingSheet />
    <StickyBookCta />

    <main>
      <section id="top" aria-label="Первый экран">
        <Hero />
      </section>

      <section id="about" aria-label="О студии">
        <Intro />
      </section>

      <section id="sale" aria-label="Акции месяца">
        <Sale />
      </section>

      <section id="price" aria-label="Цены" data-field="peony">
        <Price />
      </section>

      <section id="studios" aria-label="Студии">
        <Studios />
      </section>

      <section id="works" aria-label="Наши работы">
        <Works />
      </section>

      <section id="loyalty" aria-label="Программа лояльности" data-field="peony">
        <Loyalty />
      </section>

      <section id="social" aria-label="Будем на связи">
        <Social />
      </section>

      <section id="contacts" aria-label="Контакты">
        <Contacts />
      </section>
    </main>

    <footer id="footer" data-field="peony">
      <Footer />
    </footer>

    <script>
      import { initLenis, initAnchorScrolling } from '../scripts/lenis';
      import { registerMotion } from '../scripts/motion';
      import { initPageMotion } from '../scripts/reveals';

      registerMotion();
      initLenis();
      initAnchorScrolling();
      initPageMotion();
    </script>
  </body>
</html>
