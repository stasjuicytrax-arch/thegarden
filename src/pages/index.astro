---
import FontFaces from '../components/FontFaces.astro';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import BookingSheet from '../components/BookingSheet.astro';
import '../styles/tokens.css';
import '../styles/typography.css';
import '../styles/base.css';

const title = 'The Garden — студия красоты в Пушкине и на Фрунзенской';
const description =
  'Студия красоты The Garden: ногтевой сервис, имидж-студия, косметология, лазерная эпиляция, Brow Bar, массаж. Две студии — Пушкин и Фрунзенская. Запись онлайн.';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <FontFaces />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <Header />
    <MobileMenu />
    <BookingSheet />

    <main>
      <section id="top" aria-label="Первый экран"></section>

      <section id="about" aria-label="О студии"></section>

      <section id="sale" aria-label="Акции месяца"></section>

      <section id="price" aria-label="Цены"></section>

      <section id="studios" aria-label="Студии"></section>

      <section id="works" aria-label="Наши работы"></section>

      <section id="loyalty" aria-label="Программа лояльности"></section>

      <section id="social" aria-label="Будем на связи"></section>

      <section id="contacts" aria-label="Контакты"></section>
    </main>

    <footer id="footer"></footer>

    <script>
      import { initLenis, initAnchorScrolling } from '../scripts/lenis';
      import { registerMotion } from '../scripts/motion';

      registerMotion();
      initLenis();
      initAnchorScrolling();
    </script>
  </body>
</html>
